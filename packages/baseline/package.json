{
  "name": "@tvdoctor/baseline",
  "version": "0.1.0",
  
  "description": "Fail-closed semantic baseline comparison for TVDoctor reports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@tvdoctor/protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
