{
  "name": "tvdoctor",
  "version": "0.1.0",
  
  "description": "Command-line entry point for TVDoctor.",
  "keywords": [
    "tvdoctor",
    "tv",
    "testing",
    "cli",
    "playwright",
    "remote-control"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Ticklect/tvdoctor#readme",
  "bugs": {
    "url": "https://github.com/Ticklect/tvdoctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ticklect/tvdoctor.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tvdoctor": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "test:integration": "playwright test --config playwright.config.ts",
    "test": "vitest run --config vitest.config.ts --root ../.. packages/cli/test",
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit && tsc -p tsconfig.integration.json --pretty false",
    "prepack": "npm run build -- --force"
  },
  "dependencies": {
    "@tvdoctor/baseline": "0.1.0",
    "@tvdoctor/core": "0.1.0",
    "@tvdoctor/driver-web": "0.1.0",
    "@tvdoctor/pack-streaming": "0.1.0",
    "@tvdoctor/pack-web": "0.1.0",
    "@tvdoctor/protocol": "0.1.0",
    "@tvdoctor/reporters": "0.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
