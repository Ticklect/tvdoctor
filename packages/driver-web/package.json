{
  "name": "@tvdoctor/driver-web",
  "version": "0.1.0",
  
  "description": "Experimental Playwright web driver for TVDoctor.",
  "keywords": [
    "tvdoctor",
    "tv",
    "testing",
    "playwright",
    "chromium",
    "remote-control"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Ticklect/tvdoctor#readme",
  "bugs": {
    "url": "https://github.com/Ticklect/tvdoctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ticklect/tvdoctor.git",
    "directory": "packages/driver-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "prepack": "npm run build -- --force"
  },
  "dependencies": {
    "@tvdoctor/protocol": "0.1.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
