{
  "name": "@tvdoctor/driver-web",
  "version": "0.1.0",
  
  "description": "Experimental Playwright web driver for TVDoctor.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@tvdoctor/protocol": "0.1.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
