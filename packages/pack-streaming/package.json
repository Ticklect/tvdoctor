{
  "name": "@tvdoctor/pack-streaming",
  "version": "0.1.0",
  
  "description": "Platform-neutral semantic streaming and player journey pack for TVDoctor.",
  "keywords": [
    "tvdoctor",
    "tv",
    "testing",
    "streaming",
    "media",
    "remote-control"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Ticklect/tvdoctor#readme",
  "bugs": {
    "url": "https://github.com/Ticklect/tvdoctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ticklect/tvdoctor.git",
    "directory": "packages/pack-streaming"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "pretest:integration": "npm --prefix ../.. run clean && npm --prefix ../.. run build",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.integration.json --pretty false",
    "prepack": "npm run build -- --force"
  },
  "dependencies": {
    "@tvdoctor/core": "0.1.0",
    "@tvdoctor/protocol": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tvdoctor/driver-web": "0.1.0",
    "@tvdoctor/reporters": "0.1.0",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
