{
  "name": "@tvdoctor/driver-android",
  "version": "0.1.0",
  
  "description": "Experimental persistent-observer Android TV driver for TVDoctor.",
  "keywords": [
    "tvdoctor",
    "android-tv",
    "adb",
    "accessibility-service",
    "testing",
    "remote-control"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Ticklect/tvdoctor#readme",
  "bugs": {
    "url": "https://github.com/Ticklect/tvdoctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ticklect/tvdoctor.git",
    "directory": "packages/driver-android"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "observer/tvdoctor-observer.apk",
    "observer/observer-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "build:observer": "powershell -NoProfile -ExecutionPolicy Bypass -File observer/build-observer.ps1",
    "verify:observer": "node -e \"import('./dist/observer-asset.js').then(module => module.resolveAndroidObserverAsset())\"",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "prepack": "npm run build -- --force && npm run verify:observer"
  },
  "dependencies": {
    "@tvdoctor/protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
