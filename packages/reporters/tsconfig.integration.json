{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "noEmit": true,
    "rootDir": "../..",
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "src/**/*.ts",
    "integration/**/*.ts",
    "playwright.config.ts"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../driver-web"
    },
    {
      "path": "../protocol"
    }
  ]
}
